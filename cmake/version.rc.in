        BLOCK "080904b0"   /* UK English, Unicode */
        BEGIN
            VALUE "CompanyName",      "@VC_COMPANY@"
            VALUE "FileDescription",  "@VC_FILE_DESC@"
            VALUE "FileVersion",      "@VC_VER_STR@"
            VALUE "InternalName",     "@VC_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "@VC_COPYRIGHT@"
            VALUE "OriginalFilename", "@VC_ORIG_NAME@"
            VALUE "ProductName",      "@VC_PRODUCT@"
            VALUE "ProductVersion",   "@VC_VER_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
