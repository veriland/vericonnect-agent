 PRODUCTVERSION @VC_VER_MAJOR@,@VC_VER_MINOR@,@VC_VER_PATCH@,@VC_VER_BUILD@
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS   0x40004L        /* VOS_NT_WINDOWS32 */
 FILETYPE @VC_FILETYPE@
