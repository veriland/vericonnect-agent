# VeriConnect clang-tidy configuration.
#
# Non-blocking in CI to begin with (see .github/workflows/ci.yml): the job
# reports findings without failing the build, so the list can be worked down
# before it becomes a gate.
#
# Broad cppcoreguidelines-* is deliberately NOT enabled. The pointer
# arithmetic in the WebSocket framing and the base64 / SHA-256 codecs, and the
# reinterpret_cast byte views used to move between string_view and
# span<const uint8_t>, are intrinsic to the design - those checks would
# produce noise rather than signal. The rules picked here are the ones that
# map onto DESIGN.md §2-§4 and can be acted on.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-unused-parameters,
  misc-unused-using-decls,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  readability-const-return-type,
  readability-redundant-string-cstr,

# Empty: nothing is promoted to an error yet.
WarningsAsErrors: ''

# Only our own headers; not the standard library or OpenSSL.
HeaderFilterRegex: '.*/(core|platform|adapters|apps)/.*'

FormatStyle: file
