# VeriConnect clang-tidy configuration. Enforced on every PR by
# .github/workflows/ci.yml over core/, adapters/ and platform/posix/.
#
# Broad cppcoreguidelines-* is not enabled: the pointer arithmetic in the
# WebSocket framing and the base64 / SHA-256 codecs, and the reinterpret_cast
# byte views between string_view and span<const uint8_t>, are intrinsic to the
# design. The rules below are the ones that can be acted on.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-exception-escape,
  -bugprone-unused-return-value,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-unused-parameters,
  misc-unused-using-decls,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  readability-const-return-type,
  readability-redundant-string-cstr,

# Three bugprone checks are off for reasons specific to this tree:
#   branch-clone        deliberate duplicate arms (unknown URL scheme defaults
#                       to the TLS port; log::Level::Succ logs at Info).
#   exception-escape    fires on anything touching a std container in a
#                       codebase that does not throw.
#   unused-return-value [[nodiscard]] with -Wunused-result already covers this
#                       and honours the explicit (void) casts; this does not.

# Empty: nothing is promoted to an error yet.
WarningsAsErrors: ''

# Only our own headers; not the standard library or OpenSSL.
HeaderFilterRegex: '.*/(core|platform|adapters|apps)/.*'

FormatStyle: file
