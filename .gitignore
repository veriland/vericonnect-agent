build/
*.log
Settings.local.ini
.vs/

# Local, machine-specific Claude Code settings (do not publish)
.claude/settings.local.json

# VS Code: commit the shared project config, ignore everything else that
# lands in .vscode/ (personal overrides, extension state, logs).
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# JetBrains IDE (CLion)
.idea/
# CLion's default out-of-source build dirs (cmake-build-debug, -release, ...).
# The top-level .gitignore already covers 'build/', which is what CI uses.
cmake-build-*/

# macOS
.DS_Store
